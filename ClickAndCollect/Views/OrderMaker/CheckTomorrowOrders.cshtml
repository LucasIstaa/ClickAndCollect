@model List<ClickAndCollect.Models.Classes.Order>
@{
    ViewData["Title"] = "Tomorrow's Orders";
}

<h2>Tomorrow's Orders</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Pickup Time</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.Timeslot.Start.ToString("HH:mm") - @order.Timeslot.End.ToString("HH:mm")</td>
                    <td>@order.Status</td>
                    <td>
                        <a asp-controller="OrderMaker" asp-action="ViewOrderDetails" asp-route-orderId="@order.OrderId" class="btn btn-sm btn-primary">View details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
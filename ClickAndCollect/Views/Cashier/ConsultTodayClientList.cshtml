@model List<ClickAndCollect.Models.Classes.Order>
@{
    ViewData["Title"] = "Today's Client List";
}

<h2>Today's Client List</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Client</th>
                <th>Pickup Time</th>
                <th>Boxes</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.Client.Firstname @order.Client.Lastname</td>
                    <td>@order.Timeslot.Start.ToString("HH:mm") - @order.Timeslot.End.ToString("HH:mm")</td>
                    <td>@order.BoxesInvolved</td>
                    <td>@order.Status</td>
                    <td>
                        @if (order.Status == ClickAndCollect.Models.Classes.OrderStatus.Prepared)
                        {
                            <a asp-controller="Cashier" asp-action="FinalizeOrder" asp-route-orderId="@order.OrderId" class="btn btn-sm btn-success">Finalize</a>
                        }
                        else
                        {
                            <span class="text-muted">Waiting for preparation</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@model ClickAndCollect.Models.Classes.Order

<h2 class="mb-4">Order Confirmation</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">Your order has been placed successfully!</h4>

        <p class="mt-3">
            <strong>Order ID:</strong> @Model.OrderId <br />
            <strong>Status:</strong> @Model.Status <br />
            <strong>Pickup date:</strong> @Model.Fetchdate <br />
        </p>

        <h5 class="mt-4">Store Information</h5>
        <p>
            <strong>@Model.Store.Name</strong><br />
            @Model.Store.StreetName @Model.Store.HouseNumber<br />
            @Model.Store.PostalCode @Model.Store.CityName<br />
            <strong>Phone:</strong> @Model.Store.PhoneNumber
        </p>

        <h5 class="mt-4">Timeslot</h5>
        <p>
            @Model.Timeslot.Start - @Model.Timeslot.End
        </p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Order Summary</h4>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Orderlines)
                {
                    <tr>
                        <td>@line.Product.Name</td>
                        <td>@line.Quantity</td>
                        <td>@line.Product.Price €</td>
                        <td>@(line.Quantity * line.Product.Price) €</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="text-end mt-3">
            <strong>Total: @Model.TotalPrice() €</strong>
        </h4>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
</div>

@model List<ClickAndCollect.Models.Classes.Order>

<h2 class="mb-4">Order History</h2>

@if (Model == null || !Model.Any())
{
    <p>You have no past orders.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Status</th>
                <th>Boxes</th>
                <th>Pickup Date</th>
                <th>Timeslot</th>
                <th>Store</th>
                <th>Details</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.Status</td>
                    <td>@order.BoxesInvolved</td>
                    <td>@order.Fetchdate.ToString("yyyy-MM-dd")</td>
                    <td>@order.Timeslot.Start - @order.Timeslot.End</td>
                    <td>@order.Store.StoreId</td>
                    <td>
                        <a asp-controller="Order"
                           asp-action="OrderDetails"
                           asp-route-id="@order.OrderId"
                           class="btn btn-primary btn-sm">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model ClickAndCollect.Models.Classes.Order

<h2 class="mb-4">Order Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">Order #@Model.OrderId</h4>

        <dl class="row mt-3">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Pickup Date</dt>
            <dd class="col-sm-9">@Model.Fetchdate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Timeslot</dt>
            <dd class="col-sm-9">@Model.Timeslot.Start - @Model.Timeslot.End</dd>

            <dt class="col-sm-3">Store</dt>
            <dd class="col-sm-9">Store #@Model.Store.StoreId</dd>

            <dt class="col-sm-3">Boxes involved</dt>
            <dd class="col-sm-9">@Model.BoxesInvolved</dd>
        </dl>
    </div>
</div>

<h4>Order Lines</h4>

@if (Model.Orderlines == null || !Model.Orderlines.Any())
{
    <p>No products in this order.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Orderlines)
            {
                <tr>
                    <td>@line.Product.Name</td>
                    <td>@line.Product.Price €</td>
                    <td>@line.Quantity</td>
                    <td>@(line.Quantity * line.Product.Price) €</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-3">
        <h4>Total: <strong>@Model.TotalPrice() €</strong></h4>
    </div>
}

<a asp-controller="Order" asp-action="ViewOrdersHistory" class="btn btn-secondary mt-3">
    Back to Order History
</a>

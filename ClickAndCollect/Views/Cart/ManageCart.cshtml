@model List<ClickAndCollect.Models.Classes.CartLine>

<h2>Your Cart</h2>

@if (Model == null || !Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <td>@line.Product.Name</td>
                    <td>@line.Product.Price €</td>
                    <td>@line.Quantity</td>
                    <td>@(line.Product.Price * line.Quantity) €</td>
                    <td>
                        <form asp-controller="Cart" asp-action="RemoveProduct" method="post">
                            <input type="hidden" name="id" value="@line.Product.ProductId" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Remove
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>
        Total :
        @Model.Sum(l => l.Product.Price * l.Quantity) €
    </h3>

    <form asp-controller="Cart" asp-action="ClearCart" method="post">
        <button type="submit" class="btn btn-warning">
            Clear Cart
        </button>
    </form>

}
